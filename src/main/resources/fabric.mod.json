  },
  "recommends": {
    "fabric-api": "*"
  }
}

 	     	 	 	 		  	 	  		  		  	 		 			   	 		 	 						  		  		 		 		 	 			   		 			 						    	  	      		   		 				 				  		 	  		    						  			     	 			  			  	  		 	 	 	  	    	 	  				  